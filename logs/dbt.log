[0m18:52:17.474627 [debug] [Thread-1 (]: Using postgres connection "model.alphyra.int_company_fundamentals"
[0m18:52:17.474810 [debug] [Thread-2 (]: On model.alphyra.int_daily_stock_values: /* {"app": "dbt", "dbt_version": "1.11.6", "profile_name": "alphyra", "target_name": "dev", "node_id": "model.alphyra.int_daily_stock_values"} */

  create view "alphyra"."staging_intermediate"."int_daily_stock_values__dbt_tmp"
    
    
  as (
    

with base as (

    select
        symbol,
        date,
        open,
        close,

        avg(open) over (
            partition by symbol
            order by date
            rows between 49 preceding and current row
        ) as ma_50_open,

        avg(close) over (
            partition by symbol
            order by date
            rows between 49 preceding and current row
        ) as ma_50_close,

        avg(open) over (
            partition by symbol
            order by date
            rows between 199 preceding and current row
        ) as ma_200_open,

        avg(close) over (
            partition by symbol
            order by date
            rows between 199 preceding and current row
        ) as ma_200_close

    from "alphyra"."staging_staging"."stg_stock_prices"

),

momentum as (

    select
        *,
        (ma_50_open - ma_200_open) as ma_open_diff,
        (ma_50_close - ma_200_close) as ma_close_diff,

        (ma_50_open - ma_200_open)
            - lag(ma_50_open - ma_200_open)
              over (partition by symbol order by date)
            as ma_open_momentum,

        (ma_50_close - ma_200_close)
            - lag(ma_50_close - ma_200_close)
              over (partition by symbol order by date)
            as ma_close_momentum

    from base
)

select *
from momentum
order by symbol, date desc
  );
[0m18:52:17.475580 [debug] [Thread-1 (]: On model.alphyra.int_company_fundamentals: /* {"app": "dbt", "dbt_version": "1.11.6", "profile_name": "alphyra", "target_name": "dev", "node_id": "model.alphyra.int_company_fundamentals"} */

  create view "alphyra"."staging_intermediate"."int_company_fundamentals__dbt_tmp"
    
    
  as (
    

with company_metrics as (
    SELECT 
        symbol,
        source,
        metric_type,
        metric_name,
        metric_period,
        metric_value,
        retrieved_at,
        retrieved_date,
        raw_json,
        created_at
    
    FROM "alphyra"."staging_staging"."stg_company_financials"
),

grouped_by_company as (
    SELECT
        symbol,
        retrieved_date,

        -- pivot points
        max(case when metric_name = 'SharesOutstanding' then metric_value end) as SHARES_OUTSTANDING),
        max(case when metric_name = 'psTTM' then metric_value end) as PS_TTM,
        max(case when metric_name = 'revenueGrowth5Y' then metric_value end) as REVENUE_GROWTH_5Y,
        max(case when metric_name = 'roiTTM' then metric_value end) as ROI_TTM,
        max(case when metric_name = 'quickRatioQuarterly' then metric_value end) as QUICK_RATIO_QUARTERLY,
        max(case when metric_name = 'netProfitMarginTTM' then metric_value end) as NET_PROFIT_MARGIN_TTM,
        max(case when metric_name = 'epsGrowthTTMYoy' then metric_value end) as EPS_GROWTH_TTM_YOY,
        max(case when metric_name = 'totalDebt/totalEquityQuarterly' then metric_value end) as TOTAL_DEBT_TOTAL_EQUITY

    FROM company_metrics
    GROUP BY symbol, retrieved_date
)

select *
from grouped_by_company
  );
