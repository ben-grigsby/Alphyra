[0m07:51:43.334340 [debug] [Thread-2 (]: On model.alphyra.int_daily_stock_values: /* {"app": "dbt", "dbt_version": "1.10.15", "profile_name": "alphyra", "target_name": "dev", "node_id": "model.alphyra.int_daily_stock_values"} */

  create view "alphyra"."staging_intermediate"."int_daily_stock_values__dbt_tmp"
    
    
  as (
    

with stock_values as (
    SELECT
        symbol,
        date,
        open,
        high,
        low,
        close,
        volume,
        row_number() over (partition by symbol order by date desc) as rn
    FROM "alphyra"."staging_staging"."stg_stock_prices"

),

daily_50day_ma as (
    SELECT 
        symbol,
        AVG(open) OVER (
            PARTITION BY symbol
            ORDER BY rn
            ROWS BETWEEN 49 PRECEDING AND CURRENT ROW
        ) AS ma_50
    FROM stock_values
)

select * from daily_50day_ma
  );
