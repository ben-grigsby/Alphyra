[0m02:05:43.689951 [debug] [Thread-2 (]: On model.alphyra.int_daily_stock_values: /* {"app": "dbt", "dbt_version": "1.10.15", "profile_name": "alphyra", "target_name": "dev", "node_id": "model.alphyra.int_daily_stock_values"} */

  create view "alphyra"."staging_intermediate"."int_daily_stock_values__dbt_tmp"
    
    
  as (
    

with stock_values as (
    SELECT
        symbol,
        date,
        open,
        high,
        low,
        close,
        volume,
        row_number() over (partition by symbol order by date desc) as rn
    FROM "alphyra"."staging_staging"."stg_stock_prices"

),

with moving_average_50day as (
    SELECT
        symbol,
        avg(open) as open_ma_50day,
        avg(high) as high_ma_50day,
        avg(low) as low_ma_50day,
        avg(close) as close_ma_50day,
        avg(volume) as volume_ma_50day
    FROM stock_values
    WHERE rn <= 50
    GROUP BY symbol
)

SELECT * FROM moving_average_50day
  );
