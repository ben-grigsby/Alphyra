[0m22:48:03.382749 [debug] [Thread-3 (]: Using postgres connection "model.alphyra.int_daily_stock_values"
[0m22:48:03.383557 [debug] [Thread-3 (]: On model.alphyra.int_daily_stock_values: /* {"app": "dbt", "dbt_version": "1.11.5", "profile_name": "alphyra", "target_name": "dev", "node_id": "model.alphyra.int_daily_stock_values"} */

  create view "alphyra"."staging_table"."int_daily_stock_values__dbt_tmp"
    
    
  as (
    

with base as (

    select
        symbol,
        date,
        open,
        close,

        avg(open) over (
            partition by symbol
            order by date
            rows between 49 preceding and current row
        ) as ma_50_open,

        avg(close) over (
            partition by symbol
            order by date
            rows between 49 preceding and current row
        ) as ma_50_close,

        avg(open) over (
            partition by symbol
            order by date
            rows between 199 preceding and current row
        ) as ma_200_open,

        avg(close) over (
            partition by symbol
            order by date
            rows between 199 preceding and current row
        ) as ma_200_close

    from "alphyra"."staging_table"."stg_stock_prices"

),

momentum as (

    select
        *,
        (ma_50_open - ma_200_open) as ma_open_diff,
        (ma_50_close - ma_200_close) as ma_close_diff,

        (ma_50_open - ma_200_open)
            - lag(ma_50_open - ma_200_open)
              over (partition by symbol order by date)
            as ma_open_momentum,

        (ma_50_close - ma_200_close)
            - lag(ma_50_close - ma_200_close)
              over (partition by symbol order by date)
            as ma_close_momentum

    from base
)

select *
from momentum
order by symbol, date desc
  );
