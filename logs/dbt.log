[0m02:06:06.728014 [debug] [Thread-1 (]: On model.alphyra.int_company_fundamentals: /* {"app": "dbt", "dbt_version": "1.10.15", "profile_name": "alphyra", "target_name": "dev", "node_id": "model.alphyra.int_company_fundamentals"} */

  create view "alphyra"."staging_intermediate"."int_company_fundamentals__dbt_tmp"
    
    
  as (
    

with company_metrics as (
    SELECT 
        upper(trim(symbol)) as symbol,
        source,
        metric_type,
        metric_name,
        metric_period,
        metric_value,
        retrieved_at,
        cast(retrieved_at as date) as retrieved_date,
        raw_json,
        created_at
    
    FROM "alphyra"."staging_staging"."stg_company_financials"
),

grouped_by_company as (
    SELECT
        symbol,
        retrieved_date,

        -- pivot points
        max(case when metric_name = 'psTTM' then metric_value end) as PS_TTM,
        max(case when metric_name = 'revenueGrowth5Y' then metric_value end) as REVENUE_GROWTH_5Y,
        max(case when metric_name = 'roiTTM' then metric_value end) as ROI_TTM,
        max(case when metric_name = 'quickRatioQuarterly' then metric_value end) as QUICK_RATIO_QUARTERLY,
        max(case when metric_name = 'netProfitMarginTTM' then metric_value end) as NET_PROFIT_MARGIN_TTM,
        max(case when metric_name = 'epsGrowthTTMYoy' then metric_value end) as EPS_GROWTH_TTM_YOY,
        max(case when metric_name = 'totalDebt/totalEquityQuarterly' then metric_value end) as TOTAL_DEBT_TOTAL_EQUITY

    FROM company_metrics
    GROUP BY symbol, retrieved_date
)

select *
from grouped_by_company
  );
[0m02:06:06.728716 [debug] [Thread-2 (]: SQL status: BEGIN in 0.004 seconds
[0m02:06:06.728967 [debug] [Thread-2 (]: Using postgres connection "model.alphyra.int_daily_stock_values"
[0m02:06:06.729232 [debug] [Thread-2 (]: On model.alphyra.int_daily_stock_values: /* {"app": "dbt", "dbt_version": "1.10.15", "profile_name": "alphyra", "target_name": "dev", "node_id": "model.alphyra.int_daily_stock_values"} */

  create view "alphyra"."staging_intermediate"."int_daily_stock_values__dbt_tmp"
    
    
  as (
    

with stock_values as (
    SELECT
        symbol,
        date,
        open,
        high,
        low,
        close,
        volume,
        row_number() over (partition by symbol order by date desc) as rn
    FROM "alphyra"."staging_staging"."stg_stock_prices"

),

moving_average_50day as (
    SELECT
        symbol,
        avg(open) as open_ma_50day,
        avg(high) as high_ma_50day,
        avg(low) as low_ma_50day,
        avg(close) as close_ma_50day,
        avg(volume) as volume_ma_50day
    FROM stock_values
    WHERE rn <= 50
    GROUP BY symbol
)

SELECT * FROM moving_average_50day
  );
