[0m08:06:50.256929 [debug] [Thread-1 (]: On model.alphyra.int_daily_stock_values: /* {"app": "dbt", "dbt_version": "1.10.15", "profile_name": "alphyra", "target_name": "dev", "node_id": "model.alphyra.int_daily_stock_values"} */

  create view "alphyra"."staging_intermediate"."int_daily_stock_values__dbt_tmp"
    
    
  as (
    

with stock_values as (
    SELECT
        symbol,
        date,
        open,
        high,
        low,
        close,
        volume,
        row_number() over (partition by symbol order by date desc) as rn
    FROM "alphyra"."staging_staging"."stg_stock_prices"

),

daily_50day_ma as (
    SELECT 
        symbol,
        date,
        open,
        AVG(open) OVER (
            PARTITION BY symbol
            ORDER BY date
            ROWS BETWEEN 49 PRECEDING AND CURRENT ROW
        ) AS ma_50
    FROM stock_values
),

daily_200day_ma as (
    SELECT 
        symbol,
        date,
        open,
        AVG(open) OVER (
            PARTITION BY symbol
            ORDER BY date
            ROWS BETWEEN 199 PRECEDING AND CURRENT ROW
        ) AS ma_200
    FROM stock_values
),

joined_table as (
    SELECT 
        f0.symbol,
        f0.date,
        f0.open,
        ma_50,
        ma_200
    FROM daily_50day_ma f0
    JOIN daily_200day_ma t0
        ON f0.symbol = t0.symbol
        AND f0.date = t0.date
)

select * from joined_table ORDER BY symbol, date desc
  );
